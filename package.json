    "@opentelemetry/instrumentation": "^0.300.0",
    "ajv": "^8.20.0",
    "hono": "^4.13.13",
    "nats": "^2.29.3",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@asyncapi/specs": "^6.11.1",
    "@types/node": "^26.0.0",
    "tsx": "^4.22.1",
    "typescript": "^7.0.0"
  }
